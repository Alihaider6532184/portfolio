# Web3Forms access key — powers the contact form.
# Get / manage your key at https://web3forms.com
#
# This is a PUBLIC key by design (it is safe to expose in the browser).
# Spam protection is handled by Web3Forms via the allowed-domains setting
# in your dashboard + the honeypot field in the form.
#
# Local dev: add the same line to a file named `.env.local`.
# Vercel: add this as an Environment Variable in Project Settings → Environment Variables.
NEXT_PUBLIC_WEB3FORMS_KEY=your-web3forms-access-key-here
